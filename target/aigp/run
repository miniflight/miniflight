#!/bin/sh
set -eu

case "${1:-}" in
  -h|--help|"")
    printf 'usage: %s {vq1.r1|vq2.r1|vq2.r2} [--controller NAME] [--hz 50] [-- simulator arguments]\n' "$0"
    printf '       %s --attach --controller NAME [--hz 50]\n' "$0"
    [ "$#" -gt 0 ] && exit 0 || exit 2 ;;
esac

if ! command -v uv >/dev/null 2>&1; then
  printf 'install uv first https://docs.astral.sh/uv/getting-started/installation/\n' >&2
  exit 1
fi
base=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo=$(CDPATH= cd -- "$base/../.." && pwd)
export UV_CACHE_DIR="$base/.runtime/uv-cache"
export UV_PYTHON_INSTALL_DIR="$base/.runtime/uv-python"
exec uv run --no-project --python 3.11 --with-editable "$repo[aigp]" \
  python -m target.aigp.runner "$@"
